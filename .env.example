# PropFocus E2E — environment overrides
# Copy to `.env` and fill in secrets. Every value below already has a safe
# dev default baked into the code, so you only need to set what you want to
# override. The suite is designed to run against DEV.

# --- Core URLs (all default to https://dev.propfocus.in) ---
BASE_URL=https://dev.propfocus.in
API_URL=https://dev.propfocus.in
DASHBOARD_URL=https://dev.propfocus.in/dashboard
DASHBOARD_LOGIN_URL=https://dev.propfocus.in/dashboard/login
LANDING_URL=https://dev.propfocus.in

# --- Auth / secrets (override the baked-in defaults with real dev test creds) ---
DASHBOARD_OTP=123456
AI_SEARCH_TOKEN=

# --- Test data (point these at known-good records in the dev database) ---
TEST_PHONE=9888898888
TEST_BUYER_ID=9101
EXISTING_BUYER_ID=BID001
REVISITED_MICROSITE_URL=

# --- Broker / org scenario phone numbers ---
MAIN_BROKER_PHONE=9999999999
SUB_BROKER_PHONE=9888898888
BROKER_A_PHONE=
INACTIVE_BROKER_PHONE=7777777777
SUSPENDED_ORG_PHONE=6666666666

# --- Dashboard personas (permission / scoping tests) ---
# Defaults match the automation roster created by `npm run setup:brokers`.
# Leave blank to use those defaults, or override with real accounts.
OWNER_PHONE=9900000001
GM_PHONE=9900000002
PRESALES_MANAGER_PHONE=9900000003
PRESALES_REP_PHONE=9900000011
SALES_REP_PHONE=9900000012
MARKETING_REP_PHONE=9900000013

# --- Staff admin panel (admin.js /api/admin/auth/login) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Test data (accessible dev projects) ---
POST_VISIT_PROJECT=Abhee Tranquila
EOI_PROJECT=Unnati
PHASED_PROJECT=KNS Samooha

# --- Runner tuning ---
DEFAULT_TIMEOUT_MS=30000

# --- Performance thresholds (tests/performance) ---
PERF_API_MAX_MS=8000      # single API request budget
PERF_CONCURRENCY=10       # concurrent overview-stats requests (5xx guard)
PERF_PAGE_MAX_MS=15000    # full page-load budget
PERF_PAGES=5              # microsites pagination pages to sweep
